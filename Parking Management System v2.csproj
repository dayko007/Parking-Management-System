using System;
using System.Collections.Generic;
public class Vehicle
{
    public string PlateNumber { get; set; }
    public string VehicleType { get; set; }

    public Vehicle(string plateNumber, string vehicleType)
    {
        PlateNumber = plateNumber;
        VehicleType = vehicleType;
    }

    public void DisplayInfo()
    {
        Console.WriteLine("Plate Number: " + PlateNumber);
        Console.WriteLine("Vehicle Type: " + VehicleType);
    }
}
public class ParkingSpace
{
    public int SpaceNumber { get; set; }
    public bool IsOccupied { get; private set; }
    public Vehicle ParkedVehicle { get; private set; }

    public ParkingSpace(int number)
    {
        SpaceNumber = number;
        IsOccupied = false;
    }

    public void Occupy(Vehicle vehicle)
    {
        ParkedVehicle = vehicle;
        IsOccupied = true;
    }

    public void Release()
    {
        ParkedVehicle = null;
        IsOccupied = false;
    }
}

public class ParkingTicket
{
    public string TicketId { get; private set; }
    public Vehicle Vehicle { get; private set; }
    public ParkingSpace Space { get; private set; }
    public DateTime EntryTime { get; private set; }
    public DateTime? ExitTime { get; private set; }

    public ParkingTicket(Vehicle vehicle, ParkingSpace space)
    {
        TicketId = Guid.NewGuid().ToString("N").Substring(0, 8);
        Vehicle = vehicle;
        Space = space;
        EntryTime = DateTime.Now;
    }

    public TimeSpan CalculateDuration()
    {
        DateTime endTime = ExitTime ?? DateTime.Now;
        return endTime - EntryTime;
    }

    public void CloseTicket()
    {
        ExitTime = DateTime.Now;
    }
}

public class ParkingFeeCalculator
{
    public decimal HourlyRate { get; set; }

    public ParkingFeeCalculator(decimal hourlyRate)
    {
        HourlyRate = hourlyRate;
    }

    public decimal CalculateFee(TimeSpan duration)
    {
        double hours = Math.Max(1, Math.Ceiling(duration.TotalHours));
        return (decimal)hours * HourlyRate;
    }
}



public class ParkingLot
{
    public List<ParkingSpace> Spaces { get; private set; }
    public List<ParkingTicket> ActiveTickets { get; private set; }

    private ParkingFeeCalculator calculator;

    public ParkingLot(int numberOfSpaces, ParkingFeeCalculator feeCalculator)
    {
        calculator = feeCalculator;
        Spaces = new List<ParkingSpace>();
        ActiveTickets = new List<ParkingTicket>();

        for (int i = 1; i <= numberOfSpaces; i++)
        {
            Spaces.Add(new ParkingSpace(i));
        }
    }

    public ParkingTicket ParkVehicle(Vehicle vehicle)
    {
        foreach (ParkingTicket ticket in ActiveTickets)
        {
            if (ticket.Vehicle.PlateNumber == vehicle.PlateNumber)
            {
                Console.WriteLine("Vehicle is already parked.");
                return null;
            }
        }

        foreach (ParkingSpace space in Spaces)
        {
            if (!space.IsOccupied)
            {
                space.Occupy(vehicle);

                ParkingTicket ticket = new ParkingTicket(vehicle, space);
                ActiveTickets.Add(ticket);

                Console.WriteLine(
                    vehicle.PlateNumber + " parked in space " +
                    space.SpaceNumber);

                return ticket;
            }
        }

        Console.WriteLine("Parking lot is full.");
        return null;
    }

    public void Checkout(string ticketId)
    {
        ParkingTicket ticket = ActiveTickets.Find(
            t => t.TicketId == ticketId);

        if (ticket == null)
        {
            Console.WriteLine("Invalid ticket ID.");
            return;
        }

        ticket.CloseTicket();

        TimeSpan duration = ticket.CalculateDuration();
        decimal fee = calculator.CalculateFee(duration);

        Console.WriteLine("\n=== PARKING RECEIPT ===");
        Console.WriteLine("Ticket ID: " + ticket.TicketId);
        Console.WriteLine("Vehicle: " + ticket.Vehicle.PlateNumber);
        Console.WriteLine("Duration: " +
                          duration.TotalMinutes.ToString("F1") + " minutes");
        Console.WriteLine("Fee: RM " + fee.ToString("F2"));

        ticket.Space.Release();
        ActiveTickets.Remove(ticket);
    }

    public void DisplayParkingSpaces()
    {
        Console.WriteLine("\n=== PARKING SPACES ===");

        foreach (ParkingSpace space in Spaces)
        {
            string status = space.IsOccupied ? "Occupied" : "Available";

            Console.WriteLine(
                "Space " + space.SpaceNumber + ": " + status);
        }
    }
}


public class Program
{
    public static void Main(string[] args)
    {
        ParkingFeeCalculator calculator =
            new ParkingFeeCalculator(3.00m);

        ParkingLot parkingLot = new ParkingLot(2, calculator);

        // Sample vehicles
        Vehicle vehicle1 = new Vehicle("ABC1234", "Car");
        Vehicle vehicle2 = new Vehicle("XYZ5678", "Motorcycle");
        Vehicle vehicle3 = new Vehicle("DEF9012", "Car");

        // Display vehicle information
        vehicle1.DisplayInfo();
        vehicle2.DisplayInfo();

        // Park vehicles
        ParkingTicket ticket1 = parkingLot.ParkVehicle(vehicle1);
        ParkingTicket ticket2 = parkingLot.ParkVehicle(vehicle2);

        parkingLot.DisplayParkingSpaces();

        // Test full parking lot and duplicate vehicle
        parkingLot.ParkVehicle(vehicle3);
        parkingLot.ParkVehicle(vehicle1);

        // Checkout first vehicle
        if (ticket1 != null)
        {
            parkingLot.Checkout(ticket1.TicketId);
        }

        parkingLot.DisplayParkingSpaces();

        // Test invalid ticket
        parkingLot.Checkout("INVALID1");

        // Park another vehicle
        ParkingTicket ticket3 = parkingLot.ParkVehicle(vehicle3);

        // Checkout remaining vehicles
        if (ticket2 != null)
        {
            parkingLot.Checkout(ticket2.TicketId);
        }

        if (ticket3 != null)
        {
            parkingLot.Checkout(ticket3.TicketId);
        }

        // Display final parking space status
        parkingLot.DisplayParkingSpaces();

        Console.WriteLine(
            "Parking management program completed.");
    }
}